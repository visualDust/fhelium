{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fhelium.550w.host/schemas/release-matrix-v1.json",
  "title": "FHElium Linux binary release matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "platform",
    "python_abis",
    "scikit_build_core_version",
    "jsonschema_version",
    "builder_image",
    "builder_dockerfile_by_environment",
    "configurations",
    "artifact_base_url",
    "publication",
    "simple_index_base_url"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project": {
      "const": "fhelium"
    },
    "platform": {
      "const": "manylinux_2_28_x86_64"
    },
    "python_abis": {
      "type": "array",
      "const": [
        "cp312-cp312",
        "cp313-cp313"
      ]
    },
    "scikit_build_core_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "jsonschema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "builder_image": {
      "type": "string",
      "pattern": "^quay\\.io/pypa/manylinux_2_28_x86_64@sha256:[0-9a-f]{64}$"
    },
    "builder_dockerfile_by_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu",
        "cuda-12.9",
        "cuda-13.0"
      ],
      "properties": {
        "cpu": {
          "const": "packaging/manylinux_2_28.Dockerfile"
        },
        "cuda-12.9": {
          "const": "packaging/manylinux_2_28_cuda12_9.Dockerfile"
        },
        "cuda-13.0": {
          "const": "packaging/manylinux_2_28_cuda13.Dockerfile"
        }
      }
    },
    "configurations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/configuration"
      }
    },
    "artifact_base_url": {
      "const": "https://download.fhelium.550w.host/artifacts"
    },
    "publication": {
      "const": "static-simple-repository"
    },
    "simple_index_base_url": {
      "const": "https://download.fhelium.550w.host"
    }
  },
  "$defs": {
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "torch_requirement",
        "torch_index_url",
        "torch_runtime_version",
        "torch_cuda_version",
        "torch_cxx11_abi",
        "native_backends",
        "toolkit_version",
        "toolkit_rpms",
        "cuda_architectures",
        "expected_cuda_runtime_soname"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^torch[0-9]+-(cpu|cu[0-9]+)$"
        },
        "role": {
          "enum": [
            "current-cuda",
            "previous-cuda",
            "current-cpu",
            "previous-cpu"
          ]
        },
        "torch_requirement": {
          "type": "string",
          "pattern": "^torch==[^ ]+$"
        },
        "torch_index_url": {
          "type": "string",
          "pattern": "^https://download\\.pytorch\\.org/whl/(cpu|cu[0-9]+)$"
        },
        "torch_runtime_version": {
          "type": "string",
          "minLength": 1
        },
        "torch_cuda_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "torch_cxx11_abi": {
          "const": true
        },
        "native_backends": {
          "oneOf": [
            {
              "const": [
                "cpu"
              ]
            },
            {
              "const": [
                "cpu",
                "cuda"
              ]
            }
          ]
        },
        "toolkit_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "toolkit_rpms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cuda_architectures": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]+[a-z]?$"
          }
        },
        "expected_cuda_runtime_soname": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
